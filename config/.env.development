# Development Environment Configuration
PORT=8080
HTTP_TIMEOUT=15

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=dev_user
DB_PASS=dev_password
DB_NAME=uas_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password
REDIS_DB=0

# Environment
ENV=development

# JWT Configuration
REFRESH_JWT_SECRET=dev_refresh_secret_32_chars_minimum
REFRESH_JWT_EXPIRE=24
ACCESS_JWT_SECRET=dev_access_secret_32_chars_minimum
ACCESS_JWT_EXPIRE=1

# Rate Limiting
RATE_LIMIT_CAPACITY=100
TIME_UNIT_IN_SECONDS=60

# Cookie Configuration
COOKIE_BLOCK_KEY=dev_cookie_block_key_32_chars
COOKIE_HASH_KEY=dev_cookie_hash_key_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Security Settings
MAX_FAILED_ATTEMPTS=10
ACCOUNT_LOCK_MINUTES=5
LOGIN_RATE_LIMIT_MINUTES=1
OTP_RATE_LIMIT_MINUTES=1

# Security & Encryption
ENCRYPTION_KEY=dev_encryption_key_32_bytes_minimum
ENABLE_DB_ENCRYPTION=false
ENABLE_REDIS_TLS=false
ENABLE_MYSQL_TLS=false

# Email Service Configuration (Development)
RESEND_API_KEY=dev_resend_api_key
EMAIL_FROM=dev@localhost
RESEND_EMAIL_DOMAIN=localhost

# Twilio SMS Configuration (Development - use test credentials)
TWILIO_ACCOUNT_SID=test_twilio_account_sid
TWILIO_AUTH_TOKEN=test_twilio_auth_token
TWILIO_PHONE_NUMBER=+15000000000

# Password Policy (Development - relaxed for testing)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HISTORY_COUNT=3

# Request Size Limit
MAX_REQUEST_SIZE_MB=10

# OTP Configuration (Development - longer for testing)
OTP_EXPIRE=10