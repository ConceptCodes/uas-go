# Production Environment Configuration
PORT=8080
HTTP_TIMEOUT=15

# Database Configuration
DB_HOST=prod-db-host
DB_PORT=3306
DB_USER=prod_user
DB_PASS=prod_secure_password
DB_NAME=uas_production

# Redis Configuration
REDIS_HOST=prod-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=prod_secure_redis_password
REDIS_DB=0

# Environment
ENV=production

# JWT Configuration
REFRESH_JWT_SECRET=prod_refresh_secret_32_chars_minimum_CHANGE_ME
REFRESH_JWT_EXPIRE=24
ACCESS_JWT_SECRET=prod_access_secret_32_chars_minimum_CHANGE_ME
ACCESS_JWT_EXPIRE=1

# Rate Limiting
RATE_LIMIT_CAPACITY=100
TIME_UNIT_IN_SECONDS=60

# Cookie Configuration
COOKIE_BLOCK_KEY=prod_cookie_block_key_32_chars_minimum_CHANGE_ME
COOKIE_HASH_KEY=prod_cookie_hash_key_32_chars_minimum_CHANGE_ME
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

# Security Settings
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MINUTES=1
OTP_RATE_LIMIT_MINUTES=5

# Security & Encryption
ENCRYPTION_KEY=prod_encryption_key_32_bytes_minimum_CHANGE_ME
ENABLE_DB_ENCRYPTION=true
ENABLE_REDIS_TLS=true
ENABLE_MYSQL_TLS=true

# Email Service Configuration
RESEND_API_KEY=prod_resend_api_key_CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com
RESEND_EMAIL_DOMAIN=yourdomain.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=prod_twilio_account_sid_CHANGE_ME
TWILIO_AUTH_TOKEN=prod_twilio_auth_token_CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5

# Request Size Limit
MAX_REQUEST_SIZE_MB=10

# OTP Configuration
OTP_EXPIRE=5