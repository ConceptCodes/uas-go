# Staging Environment Configuration
PORT=8080
HTTP_TIMEOUT=15

# Database Configuration
DB_HOST=staging-db-host
DB_PORT=3306
DB_USER=staging_user
DB_PASS=staging_password
DB_NAME=uas_staging

# Redis Configuration
REDIS_HOST=staging-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password
REDIS_DB=0

# Environment
ENV=staging

# JWT Configuration
REFRESH_JWT_SECRET=staging_refresh_secret_32_chars_minimum
REFRESH_JWT_EXPIRE=24
ACCESS_JWT_SECRET=staging_access_secret_32_chars_minimum
ACCESS_JWT_EXPIRE=1

# Rate Limiting
RATE_LIMIT_CAPACITY=100
TIME_UNIT_IN_SECONDS=60

# Cookie Configuration
COOKIE_BLOCK_KEY=staging_cookie_block_key_32_chars
COOKIE_HASH_KEY=staging_cookie_hash_key_32_chars
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

# Security Settings
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MINUTES=1
OTP_RATE_LIMIT_MINUTES=5

# Security & Encryption
ENCRYPTION_KEY=staging_encryption_key_32_bytes_minimum
ENABLE_DB_ENCRYPTION=true
ENABLE_REDIS_TLS=true
ENABLE_MYSQL_TLS=true

# Email Service Configuration
RESEND_API_KEY=staging_resend_api_key
EMAIL_FROM=noreply@staging.yourdomain.com
RESEND_EMAIL_DOMAIN=staging.yourdomain.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=staging_twilio_account_sid
TWILIO_AUTH_TOKEN=staging_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5

# Request Size Limit
MAX_REQUEST_SIZE_MB=10

# OTP Configuration
OTP_EXPIRE=5