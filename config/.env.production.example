# Production Environment Configuration (Example — copy to .env.production and fill in)
PORT=8080
HTTP_TIMEOUT=15

# Database Configuration
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
DB_NAME=uas_production

# Redis Configuration
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# Environment
ENV=production

# JWT Configuration
REFRESH_JWT_SECRET=CHANGE_ME_REFRESH_SECRET_32_CHARS
REFRESH_JWT_EXPIRE=24
ACCESS_JWT_SECRET=CHANGE_ME_ACCESS_SECRET_32_CHARS
ACCESS_JWT_EXPIRE=1

# Rate Limiting
RATE_LIMIT_CAPACITY=100
TIME_UNIT_IN_SECONDS=60

# Cookie Configuration
COOKIE_BLOCK_KEY=CHANGE_ME_COOKIE_BLOCK_32_CHARS
COOKIE_HASH_KEY=CHANGE_ME_COOKIE_HASH_32_CHARS
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

# Security Settings
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MINUTES=1
OTP_RATE_LIMIT_MINUTES=5

# Security & Encryption
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_BYTES
ENABLE_DB_ENCRYPTION=true
ENABLE_REDIS_TLS=true
ENABLE_MYSQL_TLS=true

# Email Service Configuration
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com
RESEND_EMAIL_DOMAIN=yourdomain.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5

# Request Size Limit
MAX_REQUEST_SIZE_MB=10

# OTP Configuration
OTP_EXPIRE=5
