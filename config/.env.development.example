# Development Environment Configuration (Example — copy to .env.development and fill in)
PORT=8080
HTTP_TIMEOUT=15

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=dev_user
DB_PASS=CHANGE_ME
DB_NAME=uas_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# Environment
ENV=development

# JWT Configuration
REFRESH_JWT_SECRET=CHANGE_ME_REFRESH_SECRET_32_CHARS
REFRESH_JWT_EXPIRE=24
ACCESS_JWT_SECRET=CHANGE_ME_ACCESS_SECRET_32_CHARS
ACCESS_JWT_EXPIRE=1

# Rate Limiting
RATE_LIMIT_CAPACITY=100
TIME_UNIT_IN_SECONDS=60

# Cookie Configuration
COOKIE_BLOCK_KEY=CHANGE_ME_COOKIE_BLOCK_32_CHARS
COOKIE_HASH_KEY=CHANGE_ME_COOKIE_HASH_32_CHARS
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Security Settings
MAX_FAILED_ATTEMPTS=10
ACCOUNT_LOCK_MINUTES=5
LOGIN_RATE_LIMIT_MINUTES=1
OTP_RATE_LIMIT_MINUTES=1

# Security & Encryption
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_BYTES
ENABLE_DB_ENCRYPTION=false
ENABLE_REDIS_TLS=false
ENABLE_MYSQL_TLS=false

# Email Service Configuration
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=dev@localhost
RESEND_EMAIL_DOMAIN=localhost

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+15000000000

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HISTORY_COUNT=3

# Request Size Limit
MAX_REQUEST_SIZE_MB=10

# OTP Configuration
OTP_EXPIRE=10
