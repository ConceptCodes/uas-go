PORT=8080
HTTP_TIMEOUT=15

DB_HOST=mysql_host
DB_PORT=5432
DB_USER=mysql_user
DB_PASS=mysql_password
DB_NAME=mysql_db

REDIS_HOST=redis_host
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

ENV=development

REFRESH_JWT_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS_USE_OPENSSL_RAND_BASE64_32
REFRESH_JWT_EXPIRE=24

ACCESS_JWT_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS_USE_OPENSSL_RAND_BASE64_32
ACCESS_JWT_EXPIRE=1

RATE_LIMIT_CAPACITY=100
TIME_UNIT_IN_SECONDS=60

COOKIE_BLOCK_KEY=CHANGE_ME_COOKIE_BLOCK_MIN_32_CHARS_USE_OPENSSL_RAND_BASE64_32
COOKIE_HASH_KEY=CHANGE_ME_COOKIE_HASH_MIN_32_CHARS_USE_OPENSSL_RAND_BASE64_32

COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MINUTES=1
OTP_RATE_LIMIT_MINUTES=5

# Security & Encryption
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_ENCRYPTION_KEY_USE_OPENSSL_RAND_BASE64_32
ENABLE_DB_ENCRYPTION=false
ENABLE_REDIS_TLS=false
ENABLE_MYSQL_TLS=false

# Email Service Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
RESEND_EMAIL_DOMAIN=yourdomain.com
EMAIL_PROVIDER=resend

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5

# Request Size Limit
MAX_REQUEST_SIZE_MB=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUDIT_RETENTION_CLEANUP_HOURS=24
ENABLE_METRICS=true
ENABLE_PROFILING=false

# OTP Configuration
OTP_EXPIRE=5

# Optional URL used in forgot-password emails
PASSWORD_RESET_BASE_URL=http://localhost:8080/api/v1/users/credentials/reset-password
