{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "API Requests/sec",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{endpoint=~\"/api/.*\"}[5m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API 5xx Ratio",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{endpoint=~\"/api/.*\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{endpoint=~\"/api/.*\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API p95 Latency (s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{endpoint=~\"/api/.*\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate-Limit Errors",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "increase(errors_total{type=\"rate_limit\",code=\"TOO_MANY_REQUESTS\"}[10m])",
          "legendFormat": "rate_limited"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Login Attempts",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(increase(login_attempts_total[10m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Registrations",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(increase(user_registrations_total[10m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["uas", "auth"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "UAS API Operational Dashboard",
  "version": 1
}
